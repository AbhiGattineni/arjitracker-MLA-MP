{
  "name": "arjitracker-mla-mp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy",
    "test:rules": "firebase emulators:exec --only firestore --project arji-rules-test \"node --test tests/rules.test.js\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-arji",
    "dev:emulators": "VITE_USE_EMULATORS=true vite"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.34.2",
    "vite": "^8.3.5"
  }
}
